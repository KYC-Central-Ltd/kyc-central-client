{
  "name": "@kyccentral/sdk",
  "version": "0.10.0",
  "description": "Official JavaScript and TypeScript client for the KYC Central API — UK company KYC and AML risk assessment.",
  "keywords": [
    "kyc",
    "aml",
    "compliance",
    "companies-house",
    "sanctions",
    "due-diligence",
    "uk",
    "risk-assessment",
    "typescript"
  ],
  "homepage": "https://kyccentral.co.uk",
  "bugs": "https://github.com/Qualia91/kyc-central-client/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qualia91/kyc-central-client.git"
  },
  "license": "MIT",
  "author": "KYC Central <support@kyccentral.co.uk>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
